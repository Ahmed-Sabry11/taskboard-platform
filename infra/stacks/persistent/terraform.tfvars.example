# Copy to terraform.tfvars (git-ignored) and adjust.

region            = "us-east-1"
project           = "taskboard"
github_repository = "Ahmed-Sabry11/taskboard-platform"

# ---- Standard AWS account -----------------------------------------------------
enable_github_oidc = true

# ---- AWS free plan account, or AWS Academy Learner Lab -------------------------
# Neither allows creating an OIDC identity provider. On the free plan also set
# region = "eu-north-1" (or whichever single region the account is given).
# Use this line instead of the one above:
# enable_github_oidc = false

# Set to true only for the final tear-down, to delete repositories that still hold images.
ecr_force_delete = false
