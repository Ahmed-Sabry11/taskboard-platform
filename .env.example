# Template for local development. Copy to .env (which is git-ignored) and adjust.
# AWS credentials and production secrets never belong in this file.

# --- PostgreSQL container (required) ---
POSTGRES_USER=taskboard
# Change this. Use letters and digits only, because it is embedded in the URLs below.
POSTGRES_PASSWORD=localdevonly
POSTGRES_DB=taskboard

# --- Host ports (optional) ---
# Change these if a port is already taken on your machine.
# All of them are published on 127.0.0.1 only.
FRONTEND_PORT=8080
BACKEND_PORT=8000
DB_PORT=5432

# --- Backend settings ---
# development | test | production. Production disables the API docs.
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Maximum database connections per backend process (1 to 20).
DB_POOL_SIZE=5
# Comma-separated list. Leave empty unless the UI is served from another origin.
CORS_ORIGINS=

# --- Only for running the backend or its tests directly on your machine ---
# Containers do not use these two: Compose builds their URLs with the "db" hostname.
# If you changed DB_PORT above, change 5432 here to match.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB}
# The database name must end with _test; the tests refuse to run otherwise.
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:5432/taskboard_test
