# Rendered at container start: the NGINX image substitutes ${BACKEND_URL} and
# ${NGINX_LOCAL_RESOLVERS} (the DNS servers from /etc/resolv.conf) and leaves
# NGINX's own $variables untouched.
server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Container health check. Answered here so it reports on this container
    # only, whatever the state of the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same origin as the UI, so the browser needs no CORS. On AWS the load
    # balancer routes /api to the backend before requests reach this server.
    #
    # The backend's name is looked up when a request arrives and cached for
    # ten seconds. With a literal address in proxy_pass, NGINX would resolve
    # it once at start-up and keep sending traffic to that address even after
    # the backend moved, for example when its Kubernetes Service is recreated.
    # NGINX's resolver ignores DNS search domains, so BACKEND_URL must hold a
    # name the DNS server answers as written.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $backend_url "${BACKEND_URL}";
        proxy_pass $backend_url;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
